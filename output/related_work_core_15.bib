@article{lee_adaptive_2013,
	title = {Adaptive window selection for {3D} shape recovery from image focus},
	volume = {45},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {00303992},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0030399212003544},
	doi = {10.1016/j.optlastec.2012.08.003},
	abstract = {In shape from focus (SFF) techniques, focus measure plays an important role. Conventionally, two ﬁxed windows at two stages have been used to compute and enhance the focus measures, respectively. The window sizes largely affect the accuracy of the recovered depth map. A smaller window is unable to compute focus quality in textureless and smooth areas in the images. Whereas, a large window may over smooth or distort the object shape. Moreover, the use of any ﬁxed window may not provide optimal results. In this paper, instead of using a ﬁxed window at each stage, an adaptive window is proposed to compute and enhance the focus measure. At ﬁrst stage, to compute the focus measure, a criterion based on dispersion of image intensities determines the size of the mask. Similarly, at second stage, to enhance the focus measure, a criterion based on dispersion of initial focus values estimates the window size. The proposed scheme is tested using image sequences of simulated and real objects. The comparative analysis has demonstrated the effectiveness of the proposed adaptive windows.},
	language = {en},
	urldate = {2025-03-27},
	journal = {Optics \& Laser Technology},
	author = {Lee, Ikhyun and Tariq Mahmood, Muhammad and Choi, Tae-Sun},
	month = feb,
	year = {2013},
	note = {abstractTranslation: 在焦点成型（SFF）技术中，焦点测量起着重要作用。传统上，使用两个固定窗口在两个阶段分别计算和增强焦点度量。窗口大小在很大程度上影响了恢复深度图的准确性。较小的窗口无法计算图像中无纹理且平滑区域的焦点质量。而大窗户则可能使物体形状过度平滑或变形。此外，使用任何固定窗口可能无法获得最佳结果。本文提出，在每个阶段使用固定窗口，而是提出自适应窗口来计算和增强焦点度量。在第一阶段，为了计算焦点度量，基于图像强度色散的判准决定了掩膜的大小。同样，在第二阶段，为了增强焦点测量，基于初始焦点值色散的标准估计窗口大小。该方案通过模拟对象和真实物体的图像序列进行测试。比较分析已证明所提自适应窗口的有效性。
titleTranslation: 自适应窗口选择用于从图像聚焦中恢复三维形状},
	keywords = {/unread},
	pages = {21--31},
}

@article{li_adaptive_2019,
	title = {Adaptive window iteration algorithm for enhancing {3D}  shape recovery from image focus},
	volume = {17},
	issn = {1671-7694},
	url = {https://www.researching.cn/articles/OJ19d575eeec0737e0/html},
	doi = {10.3788/COL201917.061001},
	abstract = {Depth from focus (DFF) is a technique for estimating the depth and three-dimensional (3D) shape of an object from a multi-focus image sequence. At present, focus evaluation algorithms based on DFF technology will always cause inaccuracies in deep map recovery from image focus. There are two main reasons behind this issue. The first is that the window size of the focus evaluation operator has been fixed. Therefore, for some pixels, enough neighbor information cannot be covered in a fixed window and is easily disturbed by noise, which results in distortion of the model. For other pixels, the fixed window is too large, which increases the computational burden. The second is the level of difficulty to get the full focus pixels, even though the focus evaluation calculation in the actual calculation process has been completed. In order to overcome these problems, an adaptive window iteration algorithm is proposed to enhance image focus for accurate depth estimation. This algorithm will automatically adjust the window size based on gray differences in a window that aims to solve the fixed window problem. Besides that, it will also iterate evaluation values to enhance the focus evaluation of each pixel. Comparative analysis of the evaluation indicators and model quality has shown the effectiveness of the proposed adaptive window iteration algorithm.},
	language = {en},
	number = {6},
	urldate = {2025-03-27},
	journal = {Chinese Optics Letters},
	author = {Li, Long and Pan, Zhiyan and Cui, Haoyang and Liu, Jiaorong and Yang, Shenchen and Liu, Lilan and Tian, Yingzhong and Wang, Wenbin},
	year = {2019},
	note = {titleTranslation: 增强图像焦点中三维形状恢复的自适应窗口迭代算法
abstractTranslation: 焦点深度（DFF）是一种通过多焦点图像序列估算物体深度和三维（3D）形状的技术。目前，基于DFF技术的聚焦评估算法始终会导致图像聚焦深度图恢复的不准确性。这个问题背后有两个主要原因。第一是焦点评估算符的窗口大小被固定。因此，对于某些像素，固定窗口无法覆盖足够的邻居信息，且容易被噪声干扰，导致模型失真。对于其他像素，固定窗口过大，增加了计算负担。第二个是获得全焦像素的难度，尽管实际计算过程中的焦点评估计算已完成。为克服这些问题，提出了一种自适应窗口迭代算法以增强图像聚焦，实现准确的深度估计。该算法会根据窗口中的灰色差异自动调整窗口大小，旨在解决固定窗口问题。此外，它还会迭代评估值以增强每个像素的焦点评估。对评估指标和模型质量的比较分析显示了所提出的自适应窗口迭代算法的有效性。},
	keywords = {/unread, DFF, algorithm, adaptive window},
	pages = {061001},
}

@incollection{jawahar_deep_2019,
	address = {Cham},
	title = {Deep {Depth} from {Focus}},
	volume = {11363},
	isbn = {978-3-030-20892-9 978-3-030-20893-6},
	url = {http://link.springer.com/10.1007/978-3-030-20893-6_33},
	doi = {10.1007/978-3-030-20893-6_33},
	abstract = {Depth from focus (DFF) is one of the classical ill-posed inverse problems in computer vision. Most approaches recover the depth at each pixel based on the focal setting which exhibits maximal sharpness. Yet, it is not obvious how to reliably estimate the sharpness level, particularly in low-textured areas. In this paper, we propose ‘Deep Depth From Focus (DDFF)’ as the ﬁrst end-to-end learning approach to this problem. One of the main challenges we face is the hunger for data of deep neural networks. In order to obtain a signiﬁcant amount of focal stacks with corresponding groundtruth depth, we propose to leverage a light-ﬁeld camera with a co-calibrated RGB-D sensor. This allows us to digitally create focal stacks of varying sizes. Compared to existing benchmarks our dataset is 25 times larger, enabling the use of machine learning for this inverse problem. We compare our results with state-ofthe-art DFF methods and we also analyze the eﬀect of several key deep architectural components. These experiments show that our proposed method ‘DDFFNet’ achieves state-of-the-art performance in all scenes, reducing depth error by more than 75\% compared to the classical DFF methods.},
	language = {en},
	urldate = {2025-03-27},
	booktitle = {Computer {Vision} – {ACCV} 2018},
	publisher = {Springer International Publishing},
	author = {Hazirbas, Caner and Soyer, Sebastian Georg and Staab, Maximilian Christian and Leal-Taixé, Laura and Cremers, Daniel},
	editor = {Jawahar, C. V. and Li, Hongdong and Mori, Greg and Schindler, Konrad},
	year = {2019},
	note = {Series Title: Lecture Notes in Computer Science
titleTranslation: 聚焦深度
abstractTranslation: 焦点深度（DFF）是计算机视觉中经典的错态逆问题之一。大多数方法基于焦点设置恢复每个像素的深度，从而显示最大锐度。然而，如何可靠地估算清晰度水平并不明显，尤其是在低纹理区域。本文提出“深度聚焦深度（DDFF）”作为解决该问题的首个端到端学习方法。我们面临的主要挑战之一是对深度神经网络数据的渴求。为了获得大量具有对应地真深度的焦片堆栈，我们提议利用光场相机配合共校准的RGB-D传感器。这使我们能够数字化创建不同尺寸的焦点堆栈。与现有基准相比，我们的数据集规模是基准的25倍，这使得机器学习能够应用于这一逆向问题。我们将结果与最先进的DFF方法进行比较，同时分析了若干关键深度架构组件的影响。这些实验表明，我们提出的方法“DDFFNet”在所有场景中都实现了最先进的性能，深度误差比经典DFF方法减少了75\%以上。},
	keywords = {/unread, DFF, algorithm, CNN, LFCamera},
	pages = {525--541},
}

