@article{fujimura_deep_2024,
	title = {Deep {Depth} from {Focal} {Stack} with {Defocus} {Model} for {Camera}-{Setting} {Invariance}},
	volume = {132},
	issn = {0920-5691, 1573-1405},
	url = {https://link.springer.com/10.1007/s11263-023-01964-x},
	doi = {10.1007/s11263-023-01964-x},
	abstract = {We propose deep depth from focal stack (DDFS), which takes a focal stack as input of a neural network for estimating scene depth. Defocus blur is a useful cue for depth estimation. However, the size of the blur depends on not only scene depth but also camera settings such as focus distance, focal length, and f-number. Current learning-based methods without any defocus models cannot estimate a correct depth map if camera settings are different at training and test times. Our method takes a plane sweep volume as input for the constraint between scene depth, defocus images, and camera settings, and this intermediate representation enables depth estimation with different camera settings at training and test times. This camerasetting invariance can enhance the applicability of DDFS. The experimental results also indicate that our method is robust against a synthetic-to-real domain gap.},
	language = {en},
	number = {6},
	urldate = {2025-03-27},
	journal = {International Journal of Computer Vision},
	author = {Fujimura, Yuki and Iiyama, Masaaki and Funatomi, Takuya and Mukaigawa, Yasuhiro},
	month = jun,
	year = {2024},
	note = {titleTranslation: 基于焦组与散焦模型的深层深度，实现相机设置不变性
abstractTranslation: 我们提出从焦点堆栈（DDFS）进行深度测量，该方法通过神经网络将焦点堆栈作为输入，用于估计场景深度。模糊失焦是估计深度的一个有用线索。然而，模糊的大小不仅取决于场景深度，还取决于相机设置，如对焦距离、焦距和焦距。当前基于学习且无散焦模型的方法，如果相机设置在训练和测试时不同，无法估算出正确的深度图。我们的方法以平面扫描体积为输入，用于场景深度、散焦图像和相机设置之间的约束，这一中间表示使得在训练和测试时使用不同相机设置进行深度估计。这种摄像机设置不变性可以增强DDFS的适用性。实验结果还表明，我们的方法对合成到实域的差距具有鲁棒性。},
	keywords = {/unread, DFF, CNN, camera setting},
	pages = {1970--1985},
}

